{
  "name": "swaggy",
  "private": true,
  "description": "A web-based API exploration tool driven by your OpenAPI/Swagger specs.",
  "license": "MIT",
  "author": "Akhil Bojedla",
  "repository": { "type": "git", "url": "https://github.com/repo-dog/swaggy.git" },
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @swaggy/server dev",
    "e2e": "pnpm --filter @swaggy/e2e e2e",
    "e2e:ui": "pnpm --filter @swaggy/e2e e2e:ui"
  },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
