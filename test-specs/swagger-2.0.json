{
  "swagger": "2.0",
  "info": {
    "title": "Test API — Swagger 2.0",
    "version": "1.0.0",
    "description": "Exercises OpenAPI/Swagger 2.0 features: path/query/header/formData/body params, enums, defaults, arrays, $ref definitions, and every security scheme type."
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    { "name": "users", "description": "User management" },
    { "name": "files", "description": "Uploads" }
  ],
  "securityDefinitions": {
    "apiKey": { "type": "apiKey", "name": "X-API-Key", "in": "header" },
    "basicAuth": { "type": "basic" },
    "oauth2": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://api.example.com/oauth/authorize",
      "tokenUrl": "https://api.example.com/oauth/token",
      "scopes": { "read": "Read access", "write": "Write access" }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "tags": ["users"],
        "summary": "List users",
        "operationId": "listUsers",
        "parameters": [
          { "name": "status", "in": "query", "type": "string", "enum": ["active", "invited", "disabled"], "default": "active", "description": "Filter by account status." },
          { "name": "limit", "in": "query", "type": "integer", "format": "int32", "minimum": 1, "maximum": 100, "default": 20 },
          { "name": "tags", "in": "query", "type": "array", "items": { "type": "string" }, "collectionFormat": "multi", "description": "Repeatable tag filter." },
          { "name": "X-Request-Id", "in": "header", "type": "string", "required": false }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "type": "array", "items": { "$ref": "#/definitions/User" } } }
        }
      },
      "post": {
        "tags": ["users"],
        "summary": "Create a user",
        "operationId": "createUser",
        "security": [{ "apiKey": [] }],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/NewUser" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/User" } },
          "400": { "description": "Validation error", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
    },
    "/users/{userId}": {
      "parameters": [
        { "name": "userId", "in": "path", "required": true, "type": "string", "format": "uuid" }
      ],
      "get": {
        "tags": ["users"],
        "summary": "Get a user",
        "operationId": "getUser",
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/User" } },
          "404": { "description": "Not found", "schema": { "$ref": "#/definitions/Error" } }
        }
      },
      "delete": {
        "tags": ["users"],
        "summary": "Delete a user",
        "operationId": "deleteUser",
        "security": [{ "oauth2": ["write"] }],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/files": {
      "post": {
        "tags": ["files"],
        "summary": "Upload a file (multipart form)",
        "operationId": "uploadFile",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "file", "in": "formData", "type": "file", "required": true, "description": "Binary file contents." },
          { "name": "purpose", "in": "formData", "type": "string", "enum": ["avatar", "attachment"], "required": true }
        ],
        "responses": { "201": { "description": "Uploaded", "schema": { "$ref": "#/definitions/FileMeta" } } }
      }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "required": ["id", "email"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "invited", "disabled"] },
        "roles": { "type": "array", "items": { "type": "string", "enum": ["admin", "member", "viewer"] } },
        "profile": {
          "type": "object",
          "properties": {
            "bio": { "type": "string" },
            "age": { "type": "integer", "minimum": 0, "maximum": 120 }
          }
        }
      }
    },
    "NewUser": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string", "enum": ["admin", "member", "viewer"] }, "default": ["member"] }
      }
    },
    "FileMeta": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sizeBytes": { "type": "integer", "format": "int64" },
        "purpose": { "type": "string" }
      }
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
